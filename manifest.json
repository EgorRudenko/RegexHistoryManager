{
  "name": "Regex History Manager",
  "description": "Purge history with Regex and Prevent entries from being added",
  "version": "0.0",
  "manifest_version": 3,
  "action": {
    "default_icon": "clk.png",
    "default_popup": "popup.html"
  },
  "permissions": ["history", "storage", "tabs", "scripting"],
  "host_permissions":[
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "script.js",
    "type": "module"
  }
}
